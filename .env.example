# Optional provider credentials for the retrieval port.
# The skills work with NO keys: supplied sources and the cited-URL cache are
# always used. Copy this file to `.env` in the installed skill folder
# (for example ~/.dsh/skills/sourcefidelity-batch/.env), or export the same
# names in your shell. Never commit `.env`.

# Required for polite API use (Crossref, OpenAlex): your contact address.
CONTACT_EMAIL=

# Keyed providers, all optional. Leave blank to skip the provider; the review
# records it as "not enabled".
# https://core.ac.uk/services/api
CORE_API_KEY=
# https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=
# https://trove.nla.gov.au/about/create-something/using-api
TROVE_API_KEY=
# https://dp.la/developers  (free, self-service)
DPLA_API_KEY=
# Optional higher limits; not required for anonymous reads.
ZENODO_TOKEN=
